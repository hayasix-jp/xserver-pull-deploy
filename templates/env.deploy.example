# .env.deploy — this PC's connection to the server. Copy to .env.deploy and fill in. NEVER commit .env.deploy.
# (xpd init adds it to .gitignore.) Values here override xpd.config.json; environment variables override both.

# Server panel → サーバー情報 / SSH設定
XPD_HOST=sv12345.xserver.jp
XPD_USER=xs123456
XPD_PORT=10022
# /home/<server ID>/<domain>/public_html
XPD_DOCROOT=/home/xs123456/example.com/public_html
# the private key whose public half is registered in SSH設定 (ssh-keygen -t ed25519 -N "" -f ~/.ssh/xpd_deploy)
XPD_SSH_KEY=~/.ssh/xpd_deploy

# Optional
# XPD_KNOWN_HOSTS=~/.ssh/known_hosts_xserver
# XPD_STRICT_HOST_KEY=accept-new
# XPD_SSH_BIN=C:/Program Files/Git/usr/bin/ssh.exe
# XPD_RETRIES=3
# XPD_GITHUB_REPO=your-org/your-site
# XPD_NOTIFY_EMAIL=you@example.com
